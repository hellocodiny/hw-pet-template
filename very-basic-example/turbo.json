{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env.production", "**/.env"],
  "globalEnv": [
    "NEXT_PUBLIC_BASE_PATH",
    "NEXT_PUBLIC_PRODUCTION",
    "NEXT_PUBLIC_DEBUG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
