{
  "name": "ai-robot-gripper-plus-serial",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,md}\"",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "test": "node tests/run.cjs"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.19"
  }
}
